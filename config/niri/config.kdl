// Niri Configuration - VIBE MODE (Event Horizon Theme — Horizon Dark)
// Full rice: gaps, transparency, smooth animations
// Toggle with Super+Shift+V

// ============================================================================
// INPUT CONFIGURATION
// ============================================================================

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.0
        accel-profile "adaptive"
    }

    mouse {
        accel-speed 0.0
        accel-profile "adaptive"
    }

    focus-follows-mouse
    workspace-auto-back-and-forth
}

// ============================================================================
// OUTPUT CONFIGURATION
// ============================================================================

// MSI MPG 491C QD-OLED (49" ultrawide, 5120x1440 @ 100Hz RGB 4:4:4)
// DP 1.4 bandwidth: 5120x1440@144Hz exceeds 25.92 Gbps → subsampling mangles text.
// 100Hz fits cleanly at full RGB 4:4:4 8-bit. Bump higher only if DSC engages.
output "DP-3" {
    mode "5120x1440@99.932"
    scale 1.0
    position x=0 y=0
    variable-refresh-rate on-demand=true
}

// Samsung LC34G55T (34" vertical)
output "DP-2" {
    mode "3440x1440@99.982"
    transform "90"
    position x=5120 y=0
}

// Laptop display (if connected)
output "eDP-1" {
    scale 1.0
}

// ============================================================================
// LAYOUT - VIBE MODE (gaps, rounded corners feel)
// ============================================================================

layout {
    gaps 12
    background-color "transparent"

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Event Horizon focus ring — Teal accent
    focus-ring {
        width 1
        active-color "#3fc4de"
        inactive-color "#6c6f93"
    }

    border {
        width 3
        active-color "#26bbd9"
        inactive-color "#1c1e26"
    }
}

// ============================================================================
// SPAWN AT STARTUP
// ============================================================================

// Desktop shell stack (waybar + swaync + swww + swayidle + swayosd + cliphist)
// All managed as systemd user units via PartOf=graphical-session.target.
// Niri starts that target for us; we just need to nudge it once.
spawn-at-startup "sh" "-c" "systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; systemctl --user start graphical-session.target"

// ============================================================================
// XWAYLAND (for legacy X11 apps like Zoho WorkDrive)
// ============================================================================

spawn-at-startup "xwayland-satellite"

// ============================================================================
// ENVIRONMENT VARIABLES
// ============================================================================

environment {
    QT_QPA_PLATFORM "wayland"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    MOZ_ENABLE_WAYLAND "1"
    XCURSOR_THEME "Bibata-Modern-Ice"
    XCURSOR_SIZE "24"
    DISPLAY ":0"  // For XWayland apps (Steam, etc.)
}

// ============================================================================
// PREFER NO CSD
// ============================================================================

prefer-no-csd

// ============================================================================
// SCREENSHOT PATH
// ============================================================================

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ============================================================================
// ANIMATIONS - VIBE MODE (smooth, expressive)
// ============================================================================

animations {
    slowdown 1.0

    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-cubic"
    }

    window-resize {
        duration-ms 150
        curve "ease-out-cubic"
    }

    window-movement {
        duration-ms 200
        curve "ease-out-expo"
    }

    workspace-switch {
        duration-ms 250
        curve "ease-out-expo"
    }

    horizontal-view-movement {
        duration-ms 250
        curve "ease-out-expo"
    }

    config-notification-open-close {
        duration-ms 200
        curve "ease-out-cubic"
    }
}

// ============================================================================
// GLOBAL WINDOW / LAYER RULES
// ============================================================================

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// swww wallpaper: render *behind* everything so blur / transitions sit under
// windows rather than over them on workspace switches.
layer-rule {
    match namespace="^swww-daemon$"
    place-within-backdrop true
}

debug {
    honor-xdg-activation-with-invalid-serial
}

// ============================================================================
// WINDOW RULES
// ============================================================================

// Utility windows - fixed sizes
window-rule {
    match app-id="pavucontrol"
    default-column-width { fixed 600; }
}

window-rule {
    match app-id="org.gnome.Calculator"
    default-column-width { fixed 400; }
}

window-rule {
    match app-id="blueman-manager"
    default-column-width { fixed 500; }
}

window-rule {
    match app-id="nm-connection-editor"
    default-column-width { fixed 600; }
}

// File dialogs - open floating
window-rule {
    match title="Open File"
    open-floating true
}

window-rule {
    match title="Save File"
    open-floating true
}

window-rule {
    match title="Open Folder"
    open-floating true
}

// Picture-in-picture - floating and sticky
window-rule {
    match title="Picture-in-Picture"
    open-floating true
    default-floating-position x=20 y=20 relative-to="bottom-right"
}

// Steam windows
window-rule {
    match app-id="steam" title="Friends List"
    default-column-width { fixed 300; }
}

window-rule {
    match app-id="steam" title="Steam Settings"
    open-floating true
}

// Bitwarden popup
window-rule {
    match app-id="Bitwarden"
    default-column-width { fixed 400; }
}

// Thunar file manager
window-rule {
    match app-id="thunar"
    default-column-width { fixed 900; }
}

// Webapps - half width for messaging apps
window-rule {
    match app-id=r"webapp-.*"
    default-column-width { proportion 0.4; }
}

// Communication apps - open on workspace 2
window-rule {
    match app-id="webapp-google-messages"
    open-on-workspace "2"
}

window-rule {
    match app-id="webapp-whatsapp"
    open-on-workspace "2"
}

window-rule {
    match app-id="webapp-cliq"
    open-on-workspace "2"
}

window-rule {
    match app-id="webapp-ringcentral"
    open-on-workspace "2"
}

// Browsers - open on workspace 1
window-rule {
    match app-id="brave-browser"
    open-on-workspace "1"
}

window-rule {
    match app-id="firefox"
    open-on-workspace "1"
}

window-rule {
    match app-id="chromium-browser"
    open-on-workspace "1"
}

// Dev apps - open on workspace 3
window-rule {
    match app-id="code"
    open-on-workspace "3"
}

window-rule {
    match app-id="Code"
    open-on-workspace "3"
}

window-rule {
    match app-id="kitty"
    open-on-workspace "3"
}

window-rule {
    match app-id="Alacritty"
    open-on-workspace "3"
}

window-rule {
    match app-id="obsidian"
    open-on-workspace "3"
}

// Zoho WorkDrive
window-rule {
    match app-id="zohoworkdrivets"
    default-column-width { fixed 400; }
}

// Streamdeck UI
window-rule {
    match app-id="streamdeck"
    default-column-width { fixed 800; }
}

// ============================================================================
// KEYBINDINGS - OMARCHY STYLE + TUI APPS
// ============================================================================

binds {
    // ========================================================================
    // NAVIGATION
    // ========================================================================

    Mod+Space { spawn "fuzzel"; }
    Mod+W { close-window; }
    Mod+F { fullscreen-window; }
    Mod+O { toggle-window-floating; }
    Mod+Alt+F { maximize-column; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Tab { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    // Focus (Arrow + Vim)
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    // Move windows
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    // Resize
    Mod+Equal { set-column-width "+10%"; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }

    // Column grouping
    Mod+T { consume-or-expel-window-left; }
    Mod+G { consume-window-into-column; }
    Mod+Alt+G { expel-window-from-column; }

    // ========================================================================
    // LAUNCHING APPS
    // ========================================================================

    Mod+Return { spawn "kitty"; }
    Mod+Shift+B { spawn "brave"; }
    Mod+Shift+F { spawn "thunar" "--window"; }
    Mod+Shift+M { spawn "spotify"; }
    Mod+Shift+N { spawn "code"; }
    Mod+Shift+O { spawn "obsidian"; }
    Mod+Shift+Slash { spawn "bitwarden-desktop"; }
    Mod+Shift+D { spawn "kitty" "lazygit"; }
    Mod+Ctrl+T { spawn "kitty" "btop"; }

    // ========================================================================
    // TUI APPS (Midnight Ember suite)
    // ========================================================================

    // Yazi file manager
    Mod+E { spawn "kitty" "yazi"; }

    // Cava audio visualizer
    Mod+Shift+C { spawn "kitty" "cava"; }

    // ncspot (Spotify TUI)
    Mod+Shift+P { spawn "kitty" "ncspot"; }

    // Lazydocker
    Mod+Ctrl+D { spawn "kitty" "lazydocker"; }

    // ========================================================================
    // MODE TOGGLE
    // ========================================================================

    // Toggle Vibe/Focus mode
    Mod+Shift+V { spawn "sh" "-c" "~/.local/bin/toggle-mode"; }

    // Toggle night mode (blue light filter)
    Mod+Ctrl+N { spawn "sh" "-c" "~/.local/bin/night-mode toggle"; }

    // ========================================================================
    // SYSTEM CONTROLS
    // ========================================================================

    Mod+Ctrl+A { spawn "pavucontrol"; }
    Mod+Ctrl+B { spawn "blueman-manager"; }
    Mod+Ctrl+W { spawn "nm-connection-editor"; }
    Mod+Ctrl+L { spawn "swaylock"; }

    // Shell panels (replacing Noctalia IPC)
    // Mod+N  → toggle swaync notification panel
    // Mod+C  → toggle swaync control-center (same panel, explicit switcher)
    // Mod+Escape → wlogout power menu (was quit — too easy to hit by accident)
    Mod+N { spawn "swaync-client" "-t" "-sw"; }
    Mod+C { spawn "swaync-client" "-t" "-sw"; }
    Mod+Escape { spawn "wlogout"; }
    Mod+Ctrl+R { spawn "niri" "msg" "action" "load-config-file"; }
    Mod+Ctrl+Q { quit; }

    // ========================================================================
    // SCREENSHOTS & CLIPBOARD
    // ========================================================================

    Mod+Shift+S { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy"; }
    Print { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy && grim -g \"$(slurp)\" ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png"; }
    Mod+Print { spawn "sh" "-c" "grim ~/Pictures/Screenshots/screenshot-$(date +%Y%m%d-%H%M%S).png"; }
    Mod+V      { spawn "sh" "-c" "cliphist list | fuzzel --dmenu --prompt='clip: ' | cliphist decode | wl-copy"; }
    Mod+Ctrl+V { spawn "sh" "-c" "cliphist list | fuzzel --dmenu --prompt='clip: ' | cliphist decode | wl-copy"; }

    // ========================================================================
    // MEDIA KEYS
    // ========================================================================

    // Volume / mic / brightness go through swayosd so the OSD pops
    XF86AudioRaiseVolume { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute        { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute     { spawn "swayosd-client" "--input-volume" "mute-toggle"; }

    XF86MonBrightnessUp   { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown { spawn "swayosd-client" "--brightness" "lower"; }

    XF86AudioPlay  { spawn "playerctl" "play-pause"; }
    XF86AudioPause { spawn "playerctl" "play-pause"; }
    XF86AudioNext  { spawn "playerctl" "next"; }
    XF86AudioPrev  { spawn "playerctl" "previous"; }

    // ========================================================================
    // MOUSE SCROLLING
    // ========================================================================

    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+WheelScrollUp   { focus-workspace-up; }
    Mod+Shift+WheelScrollDown { move-window-to-workspace-down; }
    Mod+Shift+WheelScrollUp   { move-window-to-workspace-up; }
}
