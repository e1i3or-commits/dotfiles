# Cava Configuration - Liquid Theme (Alpine Dashboard wallpaper)

[general]
framerate = 30
autosens = 1
sensitivity = 100
bars = 0
bar_width = 1
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pipewire
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average
reverse = 0
raw_target = /dev/stdout
data_format = binary
bit_format = 16bit
ascii_max_range = 1000
bar_delimiter = 59
frame_delimiter = 10

[color]
background = default
foreground = default

# Liquid gradient: deep ocean -> wave -> cyan -> teal -> sea foam -> light foam
gradient = 1
gradient_count = 6
gradient_color_1 = '#0c4a6e'
gradient_color_2 = '#0891b2'
gradient_color_3 = '#06b6d4'
gradient_color_4 = '#14b8a6'
gradient_color_5 = '#22d3ee'
gradient_color_6 = '#67e8f9'

[smoothing]
integral = 77
monstercat = 0
waves = 1
gravity = 100
ignore = 0
noise_reduction = 0.77

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
