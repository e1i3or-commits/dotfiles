# Event Horizon theme for btop (Horizon Dark)
# From: https://github.com/OldJobobo/omarchy-event-horizon-theme

# Main bg
theme[main_bg]="#1c1e26"

# Main text color
theme[main_fg]="#fadad1"

# Title color for boxes
theme[title]="#ee64ac"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#26bbd9"

# Background color of selected item in processes box
theme[selected_bg]="#6c6f93"

# Foreground color of selected item in processes box
theme[selected_fg]="#1c1e26"

# Color of inactive/disabled text
theme[inactive_fg]="#6c6f93"

# Misc colors for processes box
theme[proc_misc]="#ee64ac"

# Box outline colors
theme[cpu_box]="#26bbd9"
theme[mem_box]="#29d398"
theme[net_box]="#59e3e3"
theme[proc_box]="#ee64ac"
theme[div_line]="#6c6f93"

# Temperature graph colors
theme[temp_start]="#ee64ac"
theme[temp_mid]="#e95678"
theme[temp_end]="#ec6a88"

# CPU graph colors
theme[cpu_start]="#59e3e3"
theme[cpu_mid]="#26bbd9"
theme[cpu_end]="#29d398"

# Mem/Disk free meter
theme[free_start]="#26bbd9"
theme[free_mid]="#59e3e3"
theme[free_end]="#6be4e6"

# Mem/Disk cached meter
theme[cached_start]="#ee64ac"
theme[cached_mid]="#f075b5"
theme[cached_end]="#ec6a88"

# Mem/Disk available meter
theme[available_start]="#29d398"
theme[available_mid]="#3fdaa4"
theme[available_end]="#26bbd9"

# Mem/Disk used meter
theme[used_start]="#ee64ac"
theme[used_mid]="#ec6a88"
theme[used_end]="#ee64ac"

# Download graph colors
theme[download_start]="#59e3e3"
theme[download_mid]="#26bbd9"
theme[download_end]="#29d398"

# Upload graph colors
theme[upload_start]="#ee64ac"
theme[upload_mid]="#ec6a88"
theme[upload_end]="#ee64ac"

# Process box color gradient
theme[process_start]="#26bbd9"
theme[process_mid]="#ee64ac"
theme[process_end]="#ee64ac"
